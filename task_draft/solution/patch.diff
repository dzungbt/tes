diff --git a/tool_znak_fe/src/features/spaces/SpacesCanvasPage.tsx b/tool_znak_fe/src/features/spaces/SpacesCanvasPage.tsx
new file mode 100644
index 0000000..91079cb
--- /dev/null
+++ b/tool_znak_fe/src/features/spaces/SpacesCanvasPage.tsx
@@ -0,0 +1,164 @@
+"use client";
+
+import "@xyflow/react/dist/style.css";
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { useSearchParams } from "next/navigation";
+import { useQuery } from "@tanstack/react-query";
+import { ReactFlow, ReactFlowProvider, useNodesState, type Node } from "@xyflow/react";
+import { Alert, App, Button, Spin, Typography } from "antd";
+import { PlusOutlined } from "@ant-design/icons";
+import { PageHeader } from "@/components/PageHeader";
+import { t, tr } from "@/i18n";
+import { getSpace, saveSpaceGraph, uploadSpaceImage, type SpaceDetail } from "@/lib/api/spaces";
+import { fitSize, maxSeq, persistNode, withFit, type UploadData, type UploadFile } from "./graph";
+import { UploadCtx, UploadNode, type UploadActions } from "./UploadNode";
+
+const AUTOSAVE_MS = 1000;
+const nodeTypes = { upload: UploadNode };
+
+type RawNode = Node & { type?: string };
+
+function Board({ spaceId, space }: { spaceId: string; space: SpaceDetail }) {
+  const { message } = App.useApp();
+  const [init] = useState(() => {
+    const all = (space.graph?.nodes ?? []) as RawNode[];
+    return {
+      nodes: all.filter((n) => n.type === "upload").map(withFit),
+      // Node khác `upload` và mọi edge không vẽ ở đây nhưng phải được gửi lại nguyên vẹn khi lưu.
+      kept: { nodes: all.filter((n) => n.type !== "upload") as unknown[], edges: (space.graph?.edges ?? []) as unknown[] },
+      seq: maxSeq(all),
+    };
+  });
+  const [nodes, setNodes, onNodesChange] = useNodesState<Node>(init.nodes);
+  const kept = useRef(init.kept);
+  const seq = useRef(init.seq);
+  const lastSaved = useRef<string | null>(null);
+
+  const payload = useCallback(
+    (list: Node[]) => ({ nodes: [...list.map(persistNode), ...kept.current.nodes], edges: kept.current.edges }),
+    [],
+  );
+
+  useEffect(() => {
+    // Không tự lưu khi chưa có thay đổi thật so với bản vừa tải/vừa lưu (đo lại kích thước cũng đổi `nodes`).
+    const snap = JSON.stringify(payload(nodes));
+    lastSaved.current ??= snap;
+    if (snap === lastSaved.current) return;
+    const timer = setTimeout(() => {
+      lastSaved.current = snap;
+      saveSpaceGraph(spaceId, JSON.parse(snap)).catch(() => {
+        lastSaved.current = null;
+      });
+    }, AUTOSAVE_MS);
+    return () => clearTimeout(timer);
+  }, [nodes, spaceId, payload]);
+
+  const patchFile = useCallback(
+    (nodeId: string, apply: (n: Node, files: UploadFile[]) => Node) =>
+      setNodes((nds) => nds.map((n) => (n.id === nodeId ? apply(n, (n.data as UploadData).files) : n))),
+    [setNodes],
+  );
+
+  const actions = useMemo<UploadActions>(
+    () => ({
+      async pick(nodeId, file) {
+        const entryId = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
+        const preview = URL.createObjectURL(file);
+        patchFile(nodeId, (n) => ({
+          ...n,
+          data: { ...n.data, files: [{ id: entryId, url: null, preview, alt: file.name, uploading: true }] },
+        }));
+        let res: Awaited<ReturnType<typeof uploadSpaceImage>> | null = null;
+        try {
+          res = await uploadSpaceImage(file);
+        } catch {
+          res = null;
+        }
+        const url = res?.url;
+        patchFile(nodeId, (n) => {
+          if (!url) return { ...n, data: { ...n.data, files: [] } };
+          const entry: UploadFile = {
+            id: entryId,
+            url,
+            thumbUrl: res?.thumb_url || undefined,
+            width: res?.width || undefined,
+            height: res?.height || undefined,
+            preview: url,
+            alt: file.name,
+            uploading: false,
+          };
+          const size = entry.width && entry.height ? fitSize(entry.width, entry.height) : {};
+          return { ...n, ...size, data: { ...n.data, files: [entry] } };
+        });
+        if (!url) message.error(tr("Tải ảnh lên máy chủ thất bại."));
+      },
+      natural(nodeId, entryId, width, height) {
+        patchFile(nodeId, (n, files) => ({
+          ...n,
+          ...fitSize(width, height),
+          data: { ...n.data, files: files.map((f) => (f.id === entryId ? { ...f, width, height } : f)) },
+        }));
+      },
+    }),
+    [patchFile, message],
+  );
+
+  function addUploadNode() {
+    seq.current += 1;
+    const n = seq.current;
+    const data: UploadData = { kind: "upload", label: `Upload #${n}`, files: [], inputs: [], outputs: [{ id: "image-out", kind: "image" }] };
+    const offset = 40 * (n % 8);
+    setNodes((nds) => [...nds, { id: `upload-${n}`, type: "upload", position: { x: 80 + offset, y: 80 + offset }, width: 300, height: 300, data }]);
+  }
+
+  return (
+    <UploadCtx.Provider value={actions}>
+      <PageHeader
+        title={space.name?.trim() || tr("Không gian chưa đặt tên")}
+        extra={<Button type="primary" icon={<PlusOutlined />} onClick={addUploadNode}>{tr("Thêm node tải lên")}</Button>}
+      />
+      <div style={{ width: "100%", height: "70vh", border: "1px solid #eee", borderRadius: 12 }}>
+        <ReactFlow nodes={nodes} onNodesChange={onNodesChange} nodeTypes={nodeTypes} fitView />
+      </div>
+    </UploadCtx.Provider>
+  );
+}
+
+function SpaceLoader({ spaceId }: { spaceId: string }) {
+  const q = useQuery({
+    queryKey: ["spaces", "detail", spaceId],
+    queryFn: () => getSpace(spaceId),
+    gcTime: 0,
+    staleTime: Infinity,
+    refetchOnWindowFocus: false,
+  });
+  if (q.isError) {
+    return (
+      <Alert
+        type="error"
+        showIcon
+        message={q.error instanceof Error ? q.error.message : String(q.error)}
+        action={<Button size="small" onClick={() => q.refetch()}>{t.common.retry}</Button>}
+      />
+    );
+  }
+  if (!q.data) return <Spin tip={tr("Đang tải không gian…")}><div style={{ padding: 48 }} /></Spin>;
+  return (
+    <ReactFlowProvider>
+      <Board spaceId={spaceId} space={q.data} />
+    </ReactFlowProvider>
+  );
+}
+
+export function SpacesCanvasPage() {
+  const spaceId = useSearchParams().get("space");
+  return (
+    <div className="page">
+      {spaceId ? (
+        <SpaceLoader key={spaceId} spaceId={spaceId} />
+      ) : (
+        <Typography.Text type="secondary">{tr("Chưa có không gian nào — tạo một cái để bắt đầu.")}</Typography.Text>
+      )}
+    </div>
+  );
+}
diff --git a/tool_znak_fe/src/features/spaces/UploadNode.tsx b/tool_znak_fe/src/features/spaces/UploadNode.tsx
new file mode 100644
index 0000000..ea5fd2c
