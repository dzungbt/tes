@@ -0,0 +1,130 @@
+"use client";
+
+import { useState } from "react";
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+import { useInfiniteQuery } from "@tanstack/react-query";
+import { Alert, Button, Segmented, Typography } from "antd";
+import { PlusOutlined } from "@ant-design/icons";
+import { t, tr } from "@/i18n";
+import { createSpace, listSpaces, type SpacesPage } from "@/lib/api/spaces";
+
+interface RawNode { id: string; type?: string; data?: { src?: string; videoSrc?: string; selectedUrl?: string } }
+interface RawSpace { space_id: number; name: string | null; updated_at: string | null; graph: { nodes?: RawNode[] } | null }
+interface Result { url: string; kind: "image" | "video" }
+
+function toResults(nodes: RawNode[]): Result[] {
+  const generated: Result[] = [];
+  const picked: Result[] = [];
+  for (const n of nodes) {
+    if (n.data?.videoSrc) generated.push({ url: n.data.videoSrc, kind: "video" });
+    else if (n.type === "image-generator" && n.data?.src) generated.push({ url: n.data.src, kind: "image" });
+    else if (n.data?.selectedUrl) picked.push({ url: n.data.selectedUrl, kind: "image" });
+  }
+  const seen = new Set<string>();
+  return [...generated, ...picked].filter((r) => (seen.has(r.url) ? false : (seen.add(r.url), true)));
+}
+
+function timeAgo(then: number): string {
+  const s = Math.max(0, Math.round((Date.now() - then) / 1000));
+  if (s < 60) return "now";
+  const m = Math.round(s / 60);
+  if (m < 60) return `${m}m ago`;
+  const h = Math.round(m / 60);
+  if (h < 24) return `${h}h ago`;
+  const d = Math.round(h / 24);
+  return d < 30 ? `${d}d ago` : `${Math.round(d / 30)}mo ago`;
+}
+
+function Card({ s }: { s: RawSpace }) {
+  const nodes = s.graph?.nodes ?? [];
+  const results = toResults(nodes).slice(0, 3);
+  const updated = s.updated_at ? new Date(s.updated_at).getTime() : null;
+  return (
+    <Link href={`/spaces?space=${s.space_id}`} style={{ display: "block", border: "1px solid #eee", borderRadius: 12, overflow: "hidden" }}>
+      <div style={{ display: "flex", height: 120, background: "#111" }}>
+        {results.map((r) =>
+          r.kind === "video" ? <video key={r.url} src={r.url} muted /> : <img key={r.url} src={r.url} alt="" />,
+        )}
+      </div>
+      <div style={{ padding: 12 }}>
+        <div>{tr("{0} node", [nodes.length])}</div>
+        <div>{s.name?.trim() || tr("Không gian chưa đặt tên")}</div>
+        {updated !== null && <div>{tr("Cập nhật {0}", [timeAgo(updated)])}</div>}
+      </div>
+    </Link>
+  );
+}
+
+export default function SpacesListPage() {
+  const router = useRouter();
+  const [creating, setCreating] = useState(false);
+  const [createError, setCreateError] = useState<string | null>(null);
+  const [tab, setTab] = useState("mine");
+  const q = useInfiniteQuery({
+    queryKey: ["spaces", "list"],
+    initialPageParam: 1,
+    queryFn: ({ pageParam }) => listSpaces(pageParam, 30),
+    getNextPageParam: (last: SpacesPage) => ((last.current_page ?? 1) < (last.last_page ?? 1) ? (last.current_page ?? 1) + 1 : undefined),
+  });
+  const spaces = (q.data?.pages ?? []).flatMap((p) => (p.data ?? []) as RawSpace[]);
+
+  async function onCreate() {
+    if (creating) return;
+    setCreating(true);
+    setCreateError(null);
+    try {
+      const res = await createSpace();
+      if (res?.space_id) router.push(`/spaces?space=${res.space_id}`);
+    } catch (e) {
+      setCreateError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setCreating(false);
+    }
+  }
+
+  return (
+    <div style={{ padding: 24 }}>
+      <Typography.Title level={3}>{tr("Không gian sáng tạo")}</Typography.Title>
+      <Typography.Paragraph>{tr("Xây dựng pipeline sinh ảnh/video dạng node và biến ý tưởng thành hiện thực.")}</Typography.Paragraph>
+      <Button type="primary" icon={<PlusOutlined />} onClick={onCreate} disabled={creating}>
+        {tr("Không gian mới")}
+      </Button>
+      {createError && <Alert type="error" showIcon message={createError} />}
+      <Segmented
+        value={tab}
+        onChange={(v) => setTab(String(v))}
+        options={[
+          { label: tr("Của tôi"), value: "mine" },
+          { label: tr("Được chia sẻ"), value: "shared", disabled: true },
+          { label: tr("Mẫu có sẵn"), value: "templates", disabled: true },
+          { label: tr("Luồng"), value: "flows", disabled: true },
+        ]}
+      />
+      {tab === "mine" && (
+        <>
+          {q.isError && (
+            <Alert
+              type="error"
+              showIcon
+              message={q.error instanceof Error ? q.error.message : String(q.error)}
+              action={!q.data ? <Button size="small" onClick={() => q.refetch()}>{t.common.retry}</Button> : undefined}
+            />
+          )}
+          {spaces.length === 0 && !q.isLoading && !q.isError ? (
+            <p>{tr("Chưa có không gian nào — tạo một cái để bắt đầu.")}</p>
+          ) : (
+            <div style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: 16 }}>
+              {spaces.map((s) => <Card key={s.space_id} s={s} />)}
+            </div>
+          )}
+          {q.hasNextPage && (
+            <Button loading={q.isFetchingNextPage} onClick={() => q.fetchNextPage()}>
+              {tr("Xem thêm")}
+            </Button>
+          )}
+        </>
+      )}
+    </div>
+  );
+}
