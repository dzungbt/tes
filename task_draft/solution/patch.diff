diff --git a/tool_znak_fe/src/lib/api/spaces.ts b/tool_znak_fe/src/lib/api/spaces.ts
new file mode 100644
index 0000000..9a13cd0
--- /dev/null
+++ b/tool_znak_fe/src/lib/api/spaces.ts
@@ -0,0 +1,62 @@
+"use client";
+
+import { api } from "@/lib/api/http";
+
+export interface RawSpaceNode {
+  id: string;
+  type?: string;
+  position: { x: number; y: number };
+  width?: number;
+  height?: number;
+  data?: { src?: string; videoSrc?: string; selectedUrl?: string };
+}
+
+export interface RawSpace {
+  space_id: number;
+  name: string | null;
+  updated_at: string | null;
+  graph: { nodes?: RawSpaceNode[] } | null;
+}
+
+export interface SpacesPage {
+  data?: RawSpace[];
+  current_page?: number;
+  last_page?: number;
+}
+
+export interface CreatedSpace {
+  space_id?: number;
+}
+
+export interface SpaceGraph {
+  nodes?: unknown[];
+  edges?: unknown[];
+}
+
+export interface SpaceDetail {
+  space_id: number;
+  name: string | null;
+  graph: SpaceGraph | null;
+}
+
+export interface UploadedImage {
+  url?: string;
+  thumb_url?: string | null;
+  width?: number | null;
+  height?: number | null;
+}
+
+export const listSpaces = (page = 1, perPage = 30) => api.get<SpacesPage>("api/spaces", { page, per_page: perPage });
+
+export const createSpace = () => api.post<CreatedSpace>("api/spaces/space");
+
+export const getSpace = (spaceId: number | string) => api.get<SpaceDetail>(`api/spaces/space/${spaceId}`);
+
+export const saveSpaceGraph = (spaceId: number | string, graph: SpaceGraph) =>
+  api.put<unknown>(`api/spaces/space/${spaceId}/graph`, graph);
+
+export function uploadSpaceImage(file: File): Promise<UploadedImage> {
+  const form = new FormData();
+  form.append("image", file);
+  return api.post<UploadedImage>("api/spaces/image/upload-image", form);
+}
