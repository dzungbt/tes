+++ b/tool_znak_fe/src/features/spaces/UploadNode.tsx
@@ -0,0 +1,76 @@
+"use client";
+
+import { createContext, useContext, useRef, useState } from "react";
+import { NodeResizer, type Node, type NodeProps } from "@xyflow/react";
+import { UploadOutlined } from "@ant-design/icons";
+import { tr } from "@/i18n";
+import type { UploadData } from "./graph";
+
+export interface UploadActions {
+  pick: (nodeId: string, file: File) => void;
+  natural: (nodeId: string, entryId: string, width: number, height: number) => void;
+}
+
+export const UploadCtx = createContext<UploadActions>({ pick: () => {}, natural: () => {} });
+
+export function UploadNode({ id, data, selected }: NodeProps<Node<UploadData>>) {
+  const { pick, natural } = useContext(UploadCtx);
+  const inputRef = useRef<HTMLInputElement>(null);
+  const [drag, setDrag] = useState(false);
+  const file = data.files[0];
+  const src = file ? (file.uploading ? file.preview : file.thumbUrl || file.url || file.preview) : null;
+  const known = Boolean(file?.width && file?.height);
+
+  function take(list: FileList | null) {
+    const f = Array.from(list ?? []).find((x) => x.type.startsWith("image/"));
+    if (f) pick(id, f);
+  }
+
+  return (
+    <div
+      style={{ width: "100%", height: "100%", position: "relative", background: "#1a1a1a", borderRadius: 12, overflow: "hidden" }}
+      onDragOver={(e) => e.preventDefault()}
+      onDrop={(e) => {
+        e.preventDefault();
+        setDrag(false);
+        take(e.dataTransfer.files);
+      }}
+    >
+      <NodeResizer isVisible={selected} keepAspectRatio={known} minWidth={80} minHeight={80} maxWidth={900} maxHeight={900} />
+      <input
+        ref={inputRef}
+        type="file"
+        accept="image/*"
+        hidden
+        onChange={(e) => {
+          take(e.target.files);
+          e.target.value = "";
+        }}
+      />
+      {src ? (
+        // eslint-disable-next-line @next/next/no-img-element
+        <img
+          src={src}
+          alt={file?.alt ?? ""}
+          draggable={false}
+          style={{ width: "100%", height: "100%", objectFit: "fill", display: "block", opacity: file?.uploading ? 0.5 : 1 }}
+          onLoad={(e) => {
+            const img = e.currentTarget;
+            if (file && !file.uploading && !known && img.naturalWidth) natural(id, file.id, img.naturalWidth, img.naturalHeight);
+          }}
+        />
+      ) : (
+        <button
+          type="button"
+          className="nodrag"
+          onClick={() => inputRef.current?.click()}
+          onDragEnter={() => setDrag(true)}
+          onDragLeave={() => setDrag(false)}
+          style={{ width: "100%", height: "100%", border: 0, color: "#aaa", background: drag ? "#2a2a2a" : "transparent", cursor: "pointer" }}
+        >
+          <UploadOutlined /> {tr("Thả ảnh vào đây hoặc bấm để tải lên")}
+        </button>
+      )}
+    </div>
+  );
+}
diff --git a/tool_znak_fe/src/features/spaces/graph.ts b/tool_znak_fe/src/features/spaces/graph.ts
