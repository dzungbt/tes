index 0000000..2d491bd
--- /dev/null
+++ b/tool_znak_fe/src/features/spaces/graph.ts
@@ -0,0 +1,70 @@
+import type { Node } from "@xyflow/react";
+
+/** Cạnh dài của khung node ngay sau khi ảnh vào (px). */
+export const LONG_SIDE = 320;
+
+export interface UploadFile {
+  id: string;
+  url: string | null;
+  thumbUrl?: string;
+  width?: number;
+  height?: number;
+  preview: string;
+  alt: string;
+  uploading: boolean;
+}
+
+export interface UploadData extends Record<string, unknown> {
+  kind: "upload";
+  label: string;
+  files: UploadFile[];
+  inputs: unknown[];
+  outputs: unknown[];
+}
+
+export function fitSize(width: number, height: number): { width: number; height: number } {
+  const k = LONG_SIDE / Math.max(width, height);
+  return { width: Math.round(width * k), height: Math.round(height * k) };
+}
+
+/** Node `upload` đã lưu mà chưa có kích thước riêng thì lấy khung khớp tỉ lệ ảnh. */
+export function withFit(node: Node): Node {
+  if (node.type !== "upload" || (node.width && node.height)) return node;
+  const f = (node.data as UploadData | undefined)?.files?.[0];
+  return f?.width && f?.height ? { ...node, ...fitSize(f.width, f.height) } : node;
+}
+
+export function persistNode(node: Node) {
+  const data = node.data as UploadData;
+  return {
+    id: node.id,
+    type: node.type,
+    position: node.position,
+    ...(node.width !== undefined ? { width: node.width } : {}),
+    ...(node.height !== undefined ? { height: node.height } : {}),
+    data: {
+      ...data,
+      // blob: preview không sống qua phiên; entry đang tải hoặc lỗi thì bỏ. Giữ nguyên cỡ ảnh gốc.
+      files: (data.files ?? [])
+        .filter((f) => f.url)
+        .map((f) => ({
+          id: f.id,
+          url: f.url,
+          ...(f.thumbUrl ? { thumbUrl: f.thumbUrl } : {}),
+          ...(f.width ? { width: f.width } : {}),
+          ...(f.height ? { height: f.height } : {}),
+          preview: f.url,
+          alt: f.alt,
+          uploading: false,
+        })),
+    },
+  };
+}
+
+/** Số thứ tự lớn nhất trong id dạng `<kind>-<n>` — node mới phải dùng số lớn hơn để không trùng id. */
+export function maxSeq(nodes: Array<{ id: string }>): number {
+  return nodes.reduce((max, n) => {
+    const m = /-(\d+)$/.exec(n.id);
+    return m ? Math.max(max, parseInt(m[1], 10)) : max;
+  }, 0);
+}
